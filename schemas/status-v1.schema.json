{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "sonar_version", "service", "service_state", "strategy", "gamefilter", "ipset", "zapret", "flowseal"],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "status" },
    "sonar_version": { "type": "string" },
    "service": { "type": "string" },
    "service_state": { "type": "string" },
    "strategy": { "type": "string" },
    "gamefilter": { "type": "string" },
    "ipset": { "type": "string" },
    "zapret": { "type": "string" },
    "flowseal": { "type": "string" }
  }
}
